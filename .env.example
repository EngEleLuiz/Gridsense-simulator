# Copy this file to .env (gitignored) to override any of these
# locally. Every value below is already the default baked into
# docker-compose.yml via ${VAR:-default} -- you only need a real .env
# file if you want something different from these dev defaults.
#
# None of these are real secrets: this stack is 100% local and
# self-hosted, with no cloud service or internet-facing component.

TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres
TIMESCALE_DB=gridsense

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

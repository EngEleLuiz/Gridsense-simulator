{
  "id": "protocol-v1",
  "description": "Frozen experiment battery: PRODIST primary, EN 50160 as European contrast; SimBench (own per-load profiles, no data transfer) as main case; aggregated load as sensitivity on SimBench; London as secondary case.",
  "output_dir": "data/protocol-v1",
  "fixed_parameters": {
    "tolerance": 0.01,
    "critical_point_rule": "min_load_high_pv",
    "critical_point_pv_fraction": 0.9,
    "stochastic_alpha": 0.1,
    "stochastic_scenarios": 60,
    "adoption_fraction": [
      0.3,
      1.0
    ],
    "existing_pv": "remove",
    "literature_load_scale": 0.25,
    "simbench_year_window": [
      "2016-01-04",
      357
    ],
    "london_radius_km": 30,
    "normalize": "source_peak"
  },
  "runs": [

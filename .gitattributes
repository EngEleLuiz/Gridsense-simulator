# Auto normalize line endings to LF on commit, CRLF on checkout (Windows)
* text=auto

# Python files
*.py text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# Markdown / documentation
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# YAML
*.yaml text eol=lf
*.yml text eol=lf

# JSON
*.json text eol=lf

# Ignore these files completely
.gitignore export-ignore
.gitattributes export-ignore

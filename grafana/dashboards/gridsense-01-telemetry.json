        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gridsense-timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sum(n_contingency_steps) AS contingency_steps FROM public_gold.mart_grid_kpis_daily WHERE network = '$network'"
        }
      ]
    },
    {
      "id": 4,
      "title": "Simulated steps",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "gridsense-timescaledb"
      },
      "gridPos": {
        "x": 18,

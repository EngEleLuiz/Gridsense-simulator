          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sum(n_steps) AS steps FROM public_gold.mart_grid_kpis_daily WHERE network = '$network'"
        }
      ]
    },
    {
      "id": 5,
      "title": "Daily load and generation",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "gridsense-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MW"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gridsense-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day_bucket AS time, avg_load_mw, peak_load_mw, min_load_mw, avg_generation_mw FROM public_gold.mart_grid_kpis_daily WHERE network = '$network' AND $__timeFilter(day_bucket) ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "title": "Line loading (hourly)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "gridsense-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 14,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gridsense-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT hour_bucket AS time, max(max_loading_percent) AS max_loading_percent, avg(avg_loading_percent) AS mean_loading_percent FROM public_gold.mart_line_loading_hourly WHERE network = '$network' AND $__timeFilter(hour_bucket) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "title": "Most loaded lines",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "gridsense-timescaledb"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gridsense-timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT line_id, round(max(max_loading_percent)::numeric, 1) AS max_loading_percent, sum(n_overload_events) AS overload_events, round(100.0 * sum(n_overload_events) / nullif(sum(n_readings), 0), 2) AS overload_rate_pct FROM public_gold.mart_line_loading_hourly WHERE network = '$network' GROUP BY line_id ORDER BY 2 DESC LIMIT 15"
        }
      ]
    }
  ]
}

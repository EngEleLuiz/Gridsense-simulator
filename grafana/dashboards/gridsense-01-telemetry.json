      "id": 1,
      "title": "Peak load",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "gridsense-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MW",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gridsense-timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT max(peak_load_mw) AS peak_load_mw FROM public_gold.mart_grid_kpis_daily WHERE network = '$network'"
        }
      ]
    },
    {
      "id": 2,
      "title": "Mean load factor",
      "type": "stat",
      "description": "Average over days of (mean load / peak load). 1.0 = flat load.",
      "datasource": {
        "type": "postgres",
        "uid": "gridsense-timescaledb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gridsense-timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(avg(load_factor)::numeric, 3) AS load_factor FROM public_gold.mart_grid_kpis_daily WHERE network = '$network'"
        }
      ]
    },
    {
      "id": 3,
      "title": "Steps with an active contingency",
      "type": "stat",

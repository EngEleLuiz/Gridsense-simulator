          "type": "postgres",
          "uid": "gridsense-timescaledb"
        },
        "query": "SELECT DISTINCT network FROM public_gold.mart_grid_kpis_daily ORDER BY 1",
        "definition": "SELECT DISTINCT network FROM public_gold.mart_grid_kpis_daily ORDER BY 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1

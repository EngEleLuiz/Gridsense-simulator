      "fieldConfig": {
        "defaults": {
          "decimals": 4
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gridsense-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT hour_bucket AS time, min(min_voltage_pu) AS min_pu, avg(avg_voltage_pu) AS mean_pu, max(max_voltage_pu) AS max_pu FROM public_gold.mart_voltage_quality_hourly WHERE network = '$network' AND is_in_scope AND $__timeFilter(hour_bucket) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "title": "Violation rate (hourly)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "gridsense-timescaledb"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gridsense-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT hour_bucket AS time, round(100.0 * sum(n_violations) / nullif(sum(n_readings), 0), 2) AS violation_rate_pct FROM public_gold.mart_voltage_quality_hourly WHERE network = '$network' AND is_in_scope AND $__timeFilter(hour_bucket) GROUP BY 1 ORDER BY 1"
        }

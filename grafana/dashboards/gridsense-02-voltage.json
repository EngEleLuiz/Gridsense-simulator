    {
      "id": 4,
      "title": "Voltage envelope (hourly, in-scope buses)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "gridsense-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
